# Copy to .env. These are local development values; nothing here is a secret.
POSTGRES_USER=tfwp
POSTGRES_PASSWORD=tfwp
POSTGRES_DB=tfwp

# Offset from the defaults so this stack can run alongside another local
# Postgres/API on 5432/8000 without a port collision.
POSTGRES_PORT=5433
API_PORT=8001

# Used when running the app or the loader on the host rather than in compose.
# Inside compose the api service overrides this to point at the db service.
DATABASE_URL=postgresql+psycopg://tfwp:tfwp@localhost:5433/tfwp
RAW_DATA_DIR=data/raw
